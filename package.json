{
  "name": "nix-homelab-tui-manager",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run website#dev",
    "hl": "bun run apps/client-app/src/index.tsx",
    "dev:client": "vp run client-app#dev",
    "dev:host": "vp run host-app#dev",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "@opentui/core": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "@types/bun": "1.3.14",
    "@types/node": "^24",
    "commander": "^15.0.0",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  }
}
